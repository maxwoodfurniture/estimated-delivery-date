{% comment %}
  Estimated Delivery Date block.
  Renders a server-side fallback line, then delivery-date.js (loaded deferred
  via the schema) fetches the estimate through the app proxy and enhances it.
{% endcomment %}

{%- liquid
  assign estimate_endpoint = '/apps/delivery/api/delivery-estimate'
  if block.settings.border_color.alpha > 0
    assign border_color = block.settings.border_color
  else
    assign border_color = 'transparent'
  endif
-%}

<delivery-estimate
  class="delivery-estimate"
  data-endpoint="{{ estimate_endpoint }}"
  data-loading-text="{{ block.settings.loading_text | escape }}"
  data-prompt-text="{{ 'delivery_estimate.zip_prompt' | t | escape }}"
  data-invalid-text="{{ 'delivery_estimate.invalid_zip' | t | escape }}"
  data-error-text="{{ 'delivery_estimate.error' | t | escape }}"
  style="
    --delivery-estimate-padding-block: {{ block.settings.vertical_padding }}px;
    --delivery-estimate-padding-inline: {{ block.settings.horizontal_padding }}px;
    --delivery-estimate-margin-block: {{ block.settings.margin }}px;
    --delivery-estimate-font-size: {{ block.settings.font_size }}px;
    --delivery-estimate-font-weight: {{ block.settings.font_weight }};
    --delivery-estimate-date-font-weight: {{ block.settings.date_font_weight }};
    --delivery-estimate-text-color: {{ block.settings.text_color }};
    --delivery-estimate-background: {{ block.settings.background_color }};
    --delivery-estimate-border-color: {{ border_color }};
    --delivery-estimate-border-radius: {{ block.settings.border_radius }}px;
    --delivery-estimate-link-color: {{ block.settings.location_link_color }};
    --delivery-estimate-link-hover-color: {{ block.settings.location_link_hover_color }};
    --delivery-estimate-button-background: {{ block.settings.button_background }};
    --delivery-estimate-button-color: {{ block.settings.button_color }};
  "
  {{ block.shopify_attributes }}
>
  <p class="delivery-estimate__status" data-delivery-status aria-live="polite">
    <span class="delivery-estimate__spinner" aria-hidden="true"></span>
    <span data-delivery-status-text>{{ block.settings.fallback_text | escape }}</span>
  </p>

  <p class="delivery-estimate__result" data-delivery-result hidden>
    {%- if block.settings.icon -%}
      <span class="delivery-estimate__icon">
        {{- block.settings.icon | image_url: width: 32 | image_tag: width: 16, height: 16, alt: '', loading: 'lazy' -}}
      </span>
    {%- endif -%}
    <span>{{ block.settings.deliver_to_text | escape }}</span>
    <button
      type="button"
      class="delivery-estimate__location"
      data-delivery-location
      aria-expanded="false"
      aria-controls="delivery-form-{{ block.id }}"
      aria-describedby="delivery-change-hint-{{ block.id }}"
    ></button>:
    <span class="delivery-estimate__visually-hidden" id="delivery-change-hint-{{ block.id }}">
      {{- 'delivery_estimate.change_location' | t -}}
    </span>
    <span class="delivery-estimate__date" data-delivery-date></span>
  </p>

  <form
    class="delivery-estimate__form"
    id="delivery-form-{{ block.id }}"
    data-delivery-form
    novalidate
    hidden
  >
    <label class="delivery-estimate__label" for="delivery-zip-{{ block.id }}">
      {{- 'delivery_estimate.zip_label' | t -}}
    </label>
    <span class="delivery-estimate__form-row">
      <input
        class="delivery-estimate__input"
        id="delivery-zip-{{ block.id }}"
        name="postalCode"
        type="text"
        inputmode="numeric"
        autocomplete="postal-code"
        maxlength="10"
        required
        aria-describedby="delivery-message-{{ block.id }}"
      >
      <button type="submit" class="delivery-estimate__submit">
        {{- 'delivery_estimate.update' | t -}}
      </button>
    </span>
    <span
      class="delivery-estimate__message"
      id="delivery-message-{{ block.id }}"
      data-delivery-message
      role="alert"
      hidden
    ></span>
  </form>
</delivery-estimate>

{% schema %}
{
  "name": "Estimated Delivery Date",
  "target": "section",
  "javascript": "delivery-date.js",
  "stylesheet": "delivery-date.css",
  "settings": [
    { "type": "header", "content": "Appearance" },
    { "type": "image_picker", "id": "icon", "label": "Icon" },
    { "type": "header", "content": "Text" },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback text",
      "info": "Shown before the estimate loads and if it cannot load.",
      "default": "Delivery estimate shown at checkout"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Calculating delivery date..."
    },
    {
      "type": "text",
      "id": "deliver_to_text",
      "label": "Deliver to text",
      "default": "Deliver to"
    },
    { "type": "header", "content": "Typography" },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "date_font_weight",
      "label": "Delivery date font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#dddddd"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "location_link_color",
      "label": "Location link color",
      "default": "#0000ee"
    },
    {
      "type": "color",
      "id": "location_link_hover_color",
      "label": "Location link hover color",
      "default": "#551a8b"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 24,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 0,
      "max": 24,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin",
      "label": "Vertical margin",
      "min": 0,
      "max": 24,
      "step": 4,
      "default": 16,
      "unit": "px"
    }
  ]
}
{% endschema %}
