# Provided by Shopify CLI in development
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=

# Postgres connection string.
# Railway: reference the database service, e.g. ${{Postgres.DATABASE_URL}}
# Local: a local Postgres, or the Railway database's public URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estimated_delivery_date

# Use FedEx sandbox endpoints (true) or production (false, default)
FEDEX_USE_SANDBOX=false

# Optional: ipinfo.io token for higher geolocation limits
IPINFO_TOKEN=
